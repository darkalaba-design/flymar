NEXT_PUBLIC_SITE_URL=https://flymar.tech
# Optional extra analytics destination. Internal analytics use /api/analytics.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Server-side lead delivery. Must accept JSON and return a 2xx response.
LEADS_ENDPOINT=
LEADS_API_TOKEN=

# Admin: npm run admin:setup configures local credentials without storing a plain password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_ENCRYPTION_KEY=

# Leave empty for temporary in-memory development. Required for production.
# Use the provider's TLS connection string; never disable certificate verification.
DATABASE_URL=

# Enable on the server only when the real bot is ready, then enable it in /admin.
TELEGRAM_DELIVERY_ENABLED=false

# Only set when your trusted reverse proxy REPLACES this header on every request.
# Without it, all traffic shares conservative rate limits.
TRUSTED_CLIENT_IP_HEADER=
